# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=8080

# Local docker-compose Postgres. In Azure this is the Neon connection string,
# injected from Key Vault, and DATABASE_SSL must be true.
DATABASE_URL=postgres://admin_console:local_dev_password@localhost:5432/admin_console
DATABASE_SSL=false

# Separate database for integration tests, so `npm test` can truncate tables
# without touching your working data. Used by `npm run db:migrate:test`.
TEST_DATABASE_URL=postgres://admin_console:local_dev_password@localhost:5432/admin_console_test

LOG_LEVEL=debug
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=admin-console-logs

CORS_ORIGINS=http://localhost:5173

# 'dev' trusts an X-Dev-User header so the UI works before MSAL is wired up.
# Switch to 'entra' once the app registration exists. The API refuses to start
# with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
DEV_AUTH_EMAIL=dev.admin@example.com

# Required only when AUTH_MODE=entra.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# First login with a valid token but no users row creates a read_only operator.
AUTO_PROVISION_ENABLED=true
