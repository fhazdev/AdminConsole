server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Container Apps probes this without going through the SPA fallback.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Same-origin API calls, mirroring the Vite dev proxy. The browser never
    # talks to APIM directly, so there is no CORS preflight and no API URL
    # baked into the bundle.
    location /api/ {
        proxy_pass ${API_ORIGIN}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pass the correlation ID through so API logs and browser errors match.
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 30s;
    }

    # Hashed asset filenames are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or a deploy leaves clients on old assets.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Client-side routing: unknown paths render the SPA, not a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
