# Copy to apps/web/.env.local for local overrides.

# 'dev' skips MSAL entirely and identifies the caller with an X-Dev-User header.
# 'entra' uses the real redirect flow and requires the three ENTRA values below.
VITE_AUTH_MODE=dev
VITE_DEV_USER_EMAIL=dev.admin@example.com

# Same-origin by default; the Vite dev server proxies /api to the backend.
# VITE_API_BASE_URL=/api

# VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
